GOOGLE_API_KEY=your-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional. Defaults to gemini-3.6-flash if unset. Free-tier daily quota is
# per model and can be far tighter on newer releases -- if you hit a 429
# RESOURCE_EXHAUSTED error, set this to a model with a more generous
# allowance, e.g. gemini-3.5-flash-lite, and re-run without touching code.
GEMINI_MODEL=gemini-3.6-flash
